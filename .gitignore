# ===========================
# GrammoQuest — .gitignore
# ===========================

# --- Environment / Secrets ---
.env
.env.local
.env.production
.env.*.local
*.env

# Firebase Admin Service Account Key — NEVER commit this
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json

# --- Node / Frontend ---
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/.DS_Store

# --- Backend seed script dependencies ---
backend/node_modules/

# --- Go / Backend ---
backend/bin/
backend/tmp/
backend/*.exe
backend/*.test

# --- OS ---
.DS_Store
Thumbs.db
*.swp
*.swo

# --- IDE ---
.vscode/settings.json
.idea/

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
