# GrammoQuest Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.

# Server
PORT=8080
ENVIRONMENT=development

# Firebase
# Your Firebase project ID (visible in Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Path to Firebase Admin SDK service account key JSON file.
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
# Keep this file OUT of Git (it's in .gitignore).
# In production (Cloud Run / GCP), leave this empty — Application Default Credentials are used.
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
