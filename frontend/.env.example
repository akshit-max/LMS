# GrammoQuest Frontend — Environment Variables
# Copy this file to .env and fill in your Firebase project values.
# NEVER commit .env to Git.
# Firebase web config values are safe to expose in frontend code (they're public by design).
# Security is enforced via Firebase Auth + Firestore rules, not by keeping these secret.

# Firebase Web Config
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Backend API URL
# In development: requests to /api/* are proxied to this via vite.config.ts
# In production: set to your deployed backend URL
VITE_API_URL=http://localhost:8080
